{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "products": {
        "ClusterId": "products",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "users": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7036" }
        }
      },
      "products": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7015" }
        }
      },
      "orders": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7248" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}